<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Reflection_01_Carol_TestFailure> a ns10:Reflection,
        owl:NamedIndividual ;
    ns9:generatesTrace <module-anchor.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Trace_08_Carol_Metacognition> ;
    ns10:reflectionText "After the first test failed, I realized we needed to reconsider our blade design approach. The materials we chose were too heavy, and we didn't account for proper torque distribution. Next iteration we should test blade pitch angles more systematically before building."^^xsd:string .

