    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:timestamp "2026-03-09T11:35:00"^^xsd:dateTime ;
    ns10:utteranceText "OK, let's plan: Bob will reinforce the tower, Alice will adjust the blade pitch, and I'll rewire the circuit. Then we test again in 20 minutes."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_ConstraintReasoning_01> a ns10:ConstraintReasoningAction,
