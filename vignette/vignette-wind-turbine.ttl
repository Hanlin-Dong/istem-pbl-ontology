    ns10:timestamp "2026-03-09T10:15:00"^^xsd:dateTime ;
    ns10:utteranceText "How do we attach the blades to the shaft securely?"^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_04> a ns10:ProcessConfusion,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Bob> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Create_Phase_1> ;
    ns10:timestamp "2026-03-09T10:50:00"^^xsd:dateTime ;
    ns10:utteranceText "Wait, should we test first or fix the wobble first? I'm not sure what the next step is."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_06> a ns10:HelpSeeking,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Alice> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Create_Phase_1> ;
    ns10:timestamp "2026-03-09T11:15:00"^^xsd:dateTime ;
    ns10:utteranceText "Can someone explain why the voltage drops when we connect the LED directly?"^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_10> a ns10:PeerArgumentation,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Carol> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:timestamp "2026-03-11T10:15:00"^^xsd:dateTime ;
    ns10:utteranceText "Adding weight to the base will reduce vibration, but if we make it TOO heavy the whole thing becomes hard to move. We need to balance stability with portability."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_11> a ns10:HelpSeeking,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Bob> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:timestamp "2026-03-11T11:15:00"^^xsd:dateTime ;
    ns10:utteranceText "How do I calculate the gear ratio between our turbine shaft and the motor?"^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_12> a ns10:KnowledgeSharing,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Carol> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:timestamp "2026-03-11T11:25:00"^^xsd:dateTime ;
    ns10:utteranceText "If the big gear has 40 teeth and the small one has 10, the ratio is 4:1 — so the motor spins 4 times for every 1 turn of the turbine."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_Agreement_01> a ns10:Agreement,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Alice> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:timestamp "2026-03-11T12:20:00"^^xsd:dateTime ;
    ns10:utteranceText "Yeah, I agree — 30 degrees seems like the sweet spot from the data."^^xsd:string .

