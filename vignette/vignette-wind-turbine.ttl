    process:timestamp "2026-03-04T10:15:00"^^xsd:dateTime ;
    process:utteranceText "Look at the data: at 15 degrees we got 2.1V, at 30 degrees 2.8V, but at 45 degrees it dropped to 2.3V. There's an optimal point somewhere."^^xsd:string .

