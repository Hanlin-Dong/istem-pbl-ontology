    ns10:triggersIteration <module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Iteration_02_Redesign> ;
    ns10:utteranceText "The whole turbine just fell over! The base is too light. When the fan was on high speed, the torque twisted the tower right off the table."^^xsd:string .

