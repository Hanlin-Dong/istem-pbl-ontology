<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_05> a ns10:KnowledgeSharing,
        owl:NamedIndividual ;
    ns9:generatesTrace <module-anchor.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Trace_03_Carol_Interdisciplinary> ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Carol> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Create_Phase_1> ;
    ns10:timestamp "2026-03-09T10:55:00"^^xsd:dateTime ;
    ns10:utteranceText "I read that the angle of the blades matters a lot. They call it 'pitch angle' — if it's too steep, the wind just pushes the blade down instead of spinning it."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_07> a ns10:PlanningUtterance,
        owl:NamedIndividual ;
    ns9:generatesTrace <module-anchor.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Trace_06_Carol_Planning> ;
