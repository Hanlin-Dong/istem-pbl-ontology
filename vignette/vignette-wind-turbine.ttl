    ns9:generatesTrace <module-anchor.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Trace_02_Carol_PeerArg> ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Carol> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Imagine_Phase_1> ;
    ns10:referencesConcept <module-knowledge.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Concept_Bernoulli> ;
    ns10:timestamp "2026-03-09T10:40:00"^^xsd:dateTime ;
    ns10:utteranceText "I think three curved blades will catch more wind than four flat ones. Real wind turbines use three blades, and they're curved like airplane wings."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_08> a ns10:IdeaGeneration,
        owl:NamedIndividual ;
    ns9:generatesTrace <module-anchor.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Trace_04_Bob_IdeaGen>,
        <module-anchor.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Trace_07_Bob_Creativity> ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Bob> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Imagine_Phase_1> ;
    ns10:timestamp "2026-03-10T10:15:00"^^xsd:dateTime ;
    ns10:utteranceText "What if we make the blades out of balsa wood instead of cardboard? It's lighter, so the wind can spin it faster. And we could carve an airfoil shape like a real wing."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_CrossTeam_01> a ns10:PeerArgumentation,
        owl:NamedIndividual ;
    ns10:directedToTeam <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Team_Alpha> ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Carol> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:referencesTeamWork <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Team_Alpha> ;
    ns10:timestamp "2026-03-11T13:15:00"^^xsd:dateTime ;
    ns10:utteranceText "Team Beta used a gearbox from an old toy car and got much higher RPM. Maybe we should try something similar instead of direct drive."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_DesignJustification_01> a ns10:DesignJustification,
        owl:NamedIndividual ;
    ns10:informsDesign <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Activity_Improve_RedesignBlades> ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Carol> ;
    ns10:isDecisionJustifiedBy <module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_S2D_Principle> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Improve_Phase_1> ;
    ns10:timestamp "2026-03-11T12:15:00"^^xsd:dateTime ;
    ns10:utteranceText "Based on our wind tunnel experiment, we know 30° blade pitch gives the highest voltage. Let's set the blades at 30° for our final design — the science proves it's the most efficient angle."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_S2D_Evidence> a ns10:EvidenceAnalyzing,
        owl:NamedIndividual ;
    ns10:isAttributedTo <module-team.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Learner_Alice> ;
    ns10:isFollowedByAction <module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_S2D_Principle> ;
    ns10:isPrecededByAction <module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_S2D_Hypothesis> ;
    ns10:occursInPhase <module-core.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#Science_FiveE_Explore_1> ;
    ns10:timestamp "2026-03-04T10:15:00"^^xsd:dateTime ;
    ns10:utteranceText "Look at the data: at 15 degrees we got 2.1V, at 30 degrees 2.8V, but at 45 degrees it dropped to 2.3V. There's an optimal point somewhere."^^xsd:string .

<module-process.ttl#http://www.semanticweb.org/ie-pbl/ontology/1.0/vignette#DA_S2D_Hypothesis> a ns10:HypothesisProposing,
