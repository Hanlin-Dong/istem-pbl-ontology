    process:timestamp "2026-03-09T11:35:00"^^xsd:dateTime ;
    process:utteranceText "OK, let's plan: Bob will reinforce the tower, Alice will adjust the blade pitch, and I'll rewire the circuit. Then we test again in 20 minutes."^^xsd:string .

